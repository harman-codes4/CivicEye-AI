# ── CivicEye AI environment (demo defaults) ─────────────────────────────
# Local SQLite fallback (default). No cloud credentials are required.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional: data directory overrides (defaults shown)
# CIVICEYE_DATA_DIR=./server/data
# CIVICEYE_UPLOAD_DIR=./server/uploads

# ── Optional Supabase (NOT wired in this prototype) ─────────────────────
# This build uses SQLite + local object storage so it runs offline.
# Never put a service-role key in the frontend. If you migrate to Supabase,
# use these names server-side only:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=civiceye-evidence

# ── Frontend (client/.env) ──────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:4000

# ── AI detection service (Snap & Report) ────────────────────────────────
# Google Gemini Vision API key (required for image analysis).
# Get one at: https://aistudio.google.com/apikey
GCP_API_KEY=your_api_key_here

# Gemini model to use (defaults to gemini-3.8-flash, a currently supported multimodal model).
# Other valid identifiers include gemini-2.5-flash, gemini-3.5-flash-lite, etc.
GEMINI_MODEL=gemini-3.8-flash

# Roboflow API key (optional; enables specialized pothole detection).
# Get one at: https://app.roboflow.com/
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Roboflow model ID in the format workspace/project/version (optional).
# The default pothole model: pothole-detection-gv5e7-edk52/1
ROBOFLOW_MODEL_ID=pothole-detection-gv5e7-edk52/1

# ── Optional: override the AI service URL if running a custom proxy ────────
# AI_SERVICE_URL=http://localhost:8000

# ── Frontend (client/.env) ──────────────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:4000

# ── AI detection service (Snap & Report) ────────────────────────────────
# Python/FastAPI YOLO service runs on port 8000 by default.
# Set AI_ENABLED=false to disable (manual registration still works).
AI_SERVICE_URL=http://localhost:8000
# Set to false to disable AI detection (manual registration still works).
AI_ENABLED=true
